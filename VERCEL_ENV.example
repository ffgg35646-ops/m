# Add these as Vercel Environment Variables (Production and Preview as needed)
MONGODB_URI=mongodb+srv://...
MONGODB_DB=your_database_name
AUTH_COLLECTION=admins
RESEND_API_KEY=re_...
EMAIL_FROM=منصة علي عليان الدولية <no-reply@your-verified-domain.com>
RESET_CODE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_URL=https://your-production-domain.com

# Admin records in AUTH_COLLECTION must include:
# { email, passwordHash, passwordSalt, role: "admin" }
# passwordHash/passwordSalt are generated by the auth reset flow (scrypt).
# Never store plaintext passwords.
