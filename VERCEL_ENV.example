# Add these as Vercel Environment Variables (Production and Preview as needed)
MONGODB_URI=mongodb+srv://...
MONGODB_DB=your_database_name
AUTH_COLLECTION=admins
# Optional: identify the protected platform-owner admin record
# OWNER_EMAIL=owner@example.com
# OWNER_ADMIN_ID=MongoDB_object_id_of_owner_admin
# PLATFORM_ROLES_COLLECTION=platform_roles

RESEND_API_KEY=re_...
EMAIL_FROM=منصة علي عليان الدولية <no-reply@your-verified-domain.com>
RESET_CODE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_URL=https://your-production-domain.com

# Admin records in AUTH_COLLECTION must include:
# { email, passwordHash, passwordSalt, role: "admin" }
# passwordHash/passwordSalt are generated by the auth reset flow (scrypt).
# Never store plaintext passwords.

# Optional collection names used by the live admin dashboard (defaults shown)
USERS_COLLECTION=users
COURSES_COLLECTION=courses
ENROLLMENTS_COLLECTION=enrollments
ORDERS_COLLECTION=orders
COUPONS_COLLECTION=coupons
ACCESS_CODES_COLLECTION=access_codes

# Optional plan display values. Leave unset until they are real values.
PLATFORM_PLAN_NAME=
PLATFORM_PLAN_RENEW_DATE=
PLATFORM_MAX_USERS=
PLATFORM_STORAGE_USED_GB=
PLATFORM_STORAGE_LIMIT_GB=

# Admin messages and notifications collections (MongoDB creates them on first write)
CONTACT_MESSAGES_COLLECTION=contact_messages
PASSWORD_RESET_REQUESTS_COLLECTION=password_reset_requests
NOTIFICATIONS_COLLECTION=notifications

# Student user records must have a stable MongoDB _id and searchable email/phone fields.
# Admin password resets write passwordHash/passwordSalt using Node.js scrypt.

# Student notification recipients / browser push subscriptions
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# STUDENT_ROLE_VALUE=student  # set only if student documents have this exact role value
PUSH_SUBSCRIPTIONS_COLLECTION=push_subscriptions
NOTIFICATION_BATCHES_COLLECTION=notification_batches
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:notifications@your-verified-domain.com

# Optional collection names used to derive enrollment filters if these collections are separate
# STUDENT_ENROLLMENTS_COLLECTION=enrollments
# STUDENT_GROUPS_COLLECTION=groups
# Optional: link student records to guardian/parent account IDs using one of
# parentUserId, guardianUserId, parentId, guardianId, parentIds, guardianIds, or parents.
# The recipients API recognizes these field names automatically.
